<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. TÍTULO PRINCIPAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejemplo de componentes Android"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp" />

        <!-- 2. SECCIÓN: COMPONENTES PARA MOSTRAR INFORMACIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Componentes para mostrar información"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este texto se muestra mediante un TextView."
            android:layout_marginBottom="8dp" />

        <!-- ImageView de ejemplo -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:src="@mipmap/ic_launcher"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progreso: 50%"
            android:layout_marginBottom="4dp" />

        <!-- ProgressBar horizontal -->
        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="50"
            android:layout_marginBottom="16dp" />

        <!-- VideoView (Representación visual simulada) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VideoView"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@android:color/black"
            android:layout_marginBottom="16dp" />

        <!-- WebView (Representación visual simulada) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WebView"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Developers"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- 3. SECCIÓN: COMPONENTES DE ENTRADA E INTERACCIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Componentes de entrada e interacción"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- ID AÑADIDO AQUÍ -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduce tu nombre"
            android:layout_marginBottom="12dp" />

        <!-- CheckBoxes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona tecnologías:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android" />

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="React" />

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flutter"
            android:layout_marginBottom="12dp" />

        <!-- RadioButtons (Agrupados en un RadioGroup) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona una modalidad:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presencial" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mixta" />
        </RadioGroup>

        <!-- Switch -->
        <Switch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notificaciones"
            android:layout_marginBottom="12dp" />

        <!-- Spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona un curso:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- ID AÑADIDO AQUÍ -->
        <Spinner
            android:id="@+id/spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- SeekBar -->
        <!-- ID AÑADIDO AL TEXTVIEW AQUÍ -->
        <TextView
            android:id="@+id/tvNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nivel seleccionado: 50"
            android:layout_marginBottom="4dp" />

        <!-- ID AÑADIDO AL SEEKBAR AQUÍ -->
        <SeekBar
            android:id="@+id/seekBarNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="50"
            android:layout_marginBottom="16dp" />

        <!-- Botón final de guardado -->
        <!-- ID AÑADIDO AQUÍ -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar información"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>